# Root and Backend Environment Configuration
# NEVER commit .env to version control

# Google Gemini API Key (Secret - loaded backend-only)
GEMINI_API_KEY=your_gemini_api_key_here

# Model Identifiers (backend/app/config.py is the single source of truth)
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=imagen-3.0-generate-002

# Database Connection (Async PostgreSQL)
DATABASE_URL=postgresql+asyncpg://forensic_user:forensic_pass@localhost:5432/forensic_artist
POSTGRES_USER=forensic_user
POSTGRES_PASSWORD=forensic_pass
POSTGRES_DB=forensic_artist
POSTGRES_PORT=5432

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
WATERMARK_TEXT=AI-GENERATED APPROXIMATION - INVESTIGATIVE LEAD ONLY
